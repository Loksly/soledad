{
  "name": "soledad",
  "version": "0.1.0",
  "description": "Colección de solitarios clásicos: sin publicidad, sin telemetría, sin compras y sin cuentas. Funciona entera sin conexión.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dailies": "tsx scripts/generate-dailies.ts",
    "sync": "cap sync android",
    "android": "cap open android",
    "apk:debug": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "size": "node scripts/check-size.mjs",
    "verify:apk": "bash scripts/verify-apk.sh",
    "pwa:serve": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "assets": "tsx scripts/prepare-assets.ts && tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.3",
    "@preact/signals": "^1.3.0",
    "idb": "^8.0.0",
    "preact": "^10.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.11.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "solitaire",
    "klondike",
    "spider",
    "freecell",
    "pyramid",
    "tripeaks",
    "pwa",
    "offline",
    "no-ads",
    "privacy"
  ],
  "private": true
}
